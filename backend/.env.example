PORT=3000
NODE_ENV=development

# Clave para firmar las sesiones. Cámbiala por un texto largo y aleatorio.
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Cuenta de administrador: se crea (o se le restablece la clave) al arrancar el servidor.
ADMIN_EMAIL=admin@pildoras.mx
ADMIN_PASSWORD=

# Base de datos PostgreSQL (Supabase). Si se omite, los datos se guardan en data/db.json.
# Supabase → Connect → Transaction pooler (puerto 6543), con tu contraseña en lugar de [YOUR-PASSWORD]
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Archivo donde se guardan los datos si no hay DATABASE_URL (por defecto backend/data/db.json)
# DB_PATH=./data/db.json
