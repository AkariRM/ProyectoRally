PORT=3000
NODE_ENV=development

# Clave para firmar las sesiones. Cámbiala por un texto largo y aleatorio.
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Cuenta de administrador: se crea (o se le restablece la clave) al arrancar el servidor.
ADMIN_EMAIL=admin@pildoras.mx
ADMIN_PASSWORD=

# Archivo donde se guardan los datos (por defecto backend/data/db.json)
# DB_PATH=./data/db.json
